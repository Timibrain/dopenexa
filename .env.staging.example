ENVIRONMENT=staging
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
REDIS_URL=redis://:<password>@<host>:6379/0
JWT_SECRET=<random-32-byte-secret>
PAYMENT_WEBHOOK_SECRET=<random-webhook-secret>
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=<paystack-test-or-live-secret>
PAYSTACK_BASE_URL=https://api.paystack.co
CORS_ORIGINS=https://staging.example.com
TRUSTED_HOSTS=staging.example.com
LOGGING_LEVEL=INFO
STORAGE_BACKEND=s3
OBJECT_STORAGE_BUCKET=<bucket>
OBJECT_STORAGE_ENDPOINT=https://<object-storage-endpoint>
OBJECT_STORAGE_ACCESS_KEY=<access-key>
OBJECT_STORAGE_SECRET_KEY=<secret-key>
APNS_ENABLED=false
APNS_TEAM_ID=<team-id>
APNS_KEY_ID=<key-id>
APNS_BUNDLE_ID=<bundle-id>
APNS_PRIVATE_KEY=<private-key-material>
APPLE_CLIENT_ID=<iOS-bundle-or-services-id>
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
APPLE_ISSUER=https://appleid.apple.com
ERROR_REPORTING_DSN=<dsn>
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
